<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hàng 1: Tên môn, Số tín chỉ, Trạng thái, Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTenMon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lập trình Android"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvSoTinChi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 tín chỉ"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTrangThaiMon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[QUA MÔN]"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/status_success"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@color/status_success_bg" />

            <ImageView
                android:id="@+id/btnMenuMonHoc"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:layout_marginStart="6dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="Tùy chọn"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="10dp" />

        <!-- Hàng 2: Điểm thành phần -->
        <TextView
            android:id="@+id/tvDiemThanhPhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Điểm TX: TX1: 8.5 | TX2: 9.0 | TX3: 8.5"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Hàng 3: Điểm thi và Tổng kết -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDiemThi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thi: 8.5"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDiemTongKet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TK10: 8.6 | Điểm chữ: A (4.0)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
