<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    tools:context=".controller.TinhDiemCanThiActivity">

    <!-- AppBar & Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Tính Điểm Cần Thi"
            app:subtitle="Dự báo điểm thi học phần (Quy chế HaUI)"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="@color/primary_light"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- NHÓM 1: CHỌN MÔN HỌC & KỲ HỌC TỪ CSDL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Thông tin môn học"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn môn học có sẵn từ CSDL hoặc tự nhập môn học mới"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Spinner Chọn Kỳ học -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kỳ học:"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />

                    <Spinner
                        android:id="@+id/spnKyHoc"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Spinner Chọn Môn học -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Môn học:"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />

                    <Spinner
                        android:id="@+id/spnMonHoc"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp" />

                    <!-- Trạng thái rỗng môn học (UI 8) -->
                    <TextView
                        android:id="@+id/tvEmptyMonHoc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="ℹ️ Chưa có môn học nào trong kỳ này. Bạn có thể tự nhập môn bên dưới."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:padding="6dp"
                        android:background="@color/status_info_bg"
                        android:layout_marginTop="6dp" />

                    <!-- Trường nhập Tên môn học -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTenMon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Tên môn học *"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTenMon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Số tín chỉ (nếu có từ CSDL) -->
                    <TextView
                        android:id="@+id/tvSoTinChiInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NHÓM 2: ĐIỂM THÀNH PHẦN (UC-03) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Điểm thành phần đã có (Hệ 10)"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Miền giá trị hợp lệ từ 0.0 đến 10.0 (chấp nhận dấu chấm hoặc phẩy)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/chkCoTx3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Môn học có 3 điểm thành phần (TX1, TX2, TX3)"
                        android:checked="true"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTx1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:hint="TX1 *"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTx1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTx2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:hint="TX2 *"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTx2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTx3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:hint="TX3 *"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTx3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NHÓM 3: CẤU HÌNH TRỌNG SỐ (%) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3. Cấu hình trọng số (%)"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btnDefaultTrongSo"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Mặc định"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />

                        <Button
                            android:id="@+id/btnSaveTrongSo"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Lưu làm mặc định"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />

                    </LinearLayout>

                    <!-- Nhãn kiểm tra tổng trọng số trực tiếp (UI 5, UX 4) -->
                    <TextView
                        android:id="@+id/tvTongTrongSoStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ Tổng trọng số: 100% (Hợp lệ)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_success"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWTx1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:hint="TS TX1 %"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtWTx1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWTx2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:hint="TS TX2 %"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtWTx2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWTx3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:hint="TS TX3 %"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtWTx3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWThi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:hint="TS Thi %"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtWThi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="40"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NHÓM 4: MỤC TIÊU ĐIỂM SỐ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Mục tiêu điểm tổng kết mong muốn"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn thang điểm chữ (A, B+, B...) hoặc nhập điểm hệ 10 [4.0 - 10.0]"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            android:id="@+id/spnMucTieuChu"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.3"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilMucTieu10"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Mốc hệ 10 *"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtMucTieu10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="8.5"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NÚT HÀNH ĐỘNG CHÍNH (UI 7: >= 48dp) -->
            <Button
                android:id="@+id/btnTinhDiem"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="TÍNH ĐIỂM CẦN THI"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp" />

            <!-- EMPTY STATE: KHI CHƯA TÍNH ĐIỂM (UI 8) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="36sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có kết quả dự báo"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vui lòng nhập điểm thành phần, chọn mục tiêu học tập và bấm nút 'TÍNH ĐIỂM CẦN THI' ở trên để xem phân tích chi tiết."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KẾT QUẢ DỰ BÁO CHI TIẾT (Ẩn khi chưa tính) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKetQua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KẾT QUẢ DỰ BÁO CHI TIẾT"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:textSize="17sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginVertical="10dp" />

                    <!-- Điểm quá trình -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Điểm quá trình hiện tại:"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDiemQuaTrinh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Khung Điểm thi cần đạt (UI 3: Không chỉ dựa vào màu sắc mà có Icon + Nhãn chữ) -->
                    <LinearLayout
                        android:id="@+id/layoutKetQuaHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/status_success_bg">

                        <TextView
                            android:id="@+id/tvKetQuaIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐIỂM THI CẦN ĐẠT"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvDiemThiCanDat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- / 10"
                            android:textColor="@color/status_success"
                            android:textStyle="bold"
                            android:textSize="36sp" />

                        <TextView
                            android:id="@+id/tvTrangThaiBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[KHẢ THI]"
                            android:textStyle="bold"
                            android:textColor="@color/status_success"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <!-- Lời khuyên chi tiết & Cảnh báo quy chế HaUI -->
                    <TextView
                        android:id="@+id/tvLoiKhuyen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lời khuyên chi tiết..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Điểm tối đa khi thi 10 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Điểm TK tối đa (nếu thi 10):"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDiemToiDa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10.0 (A)"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- NÚT LƯU ĐIỂM THI DỰ KIẾN VÀO CSDL (UC-03 & UC-08, UX 5 xác nhận) -->
                    <Button
                        android:id="@+id/btnSavePredictedToDB"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="💾 Lưu điểm thi dự kiến vào CSDL"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/primary"
                        android:layout_marginTop="14dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BẢNG DỰ ĐOÁN TOÀN BỘ THANG ĐIỂM CHỮ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBangMucTieu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DỰ BÁO CHO TẤT CẢ CÁC MỨC ĐIỂM CHỮ"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tra cứu nhanh số điểm thi cần thiết để đạt A, B+, B, C+, C, D+, D"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBangMucTieu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
