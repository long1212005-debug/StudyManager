<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyManager"
        android:usesCleartextTraffic="true">

        <!-- Màn hình cào dữ liệu qua WebView (Đăng nhập HaUI) -->
        <activity
            android:name=".controller.LayDuLieuWebViewActivity"
            android:exported="true"
            android:label="Đăng nhập HaUI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính (Dashboard) -->
        <activity
            android:name=".controller.MainActivity"
            android:exported="true"
            android:label="Trang chủ"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình lấy điểm thành phần TX1, TX2, TX3 -->
        <activity
            android:name=".controller.LayDiemTPWebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Thống kê biểu đồ MPAndroidChart -->
        <activity
            android:name=".controller.ThongKe"
            android:exported="false" />

        <!-- Màn hình Lộ trình học tập & Tư vấn cải thiện điểm -->
        <activity
            android:name=".controller.LoTrinhHocTapActivity"
            android:exported="false" />

        <!-- Màn hình Chi tiết kỳ học -->
        <activity
            android:name=".controller.ChiTietKyHocActivity"
            android:exported="false" />

        <!-- Màn hình menu Công cụ & Tiện ích -->
        <activity
            android:name=".controller.CongCuActivity"
            android:exported="false" />

        <!-- Màn hình Mô phỏng tính điểm cần thi -->
        <activity
            android:name=".controller.TinhDiemCanThiActivity"
            android:exported="false" />

        <!-- Màn hình Cài đặt & Liên hệ -->
        <activity
            android:name=".controller.CaiDatActivity"
            android:exported="false" />

    </application>

</manifest>
